# xiaomiproxy build-time secrets. Copy to .env (gitignored) at the project root.
# build.rs bakes these INTO the binary at compile time, so the binary deployed
# to neuraprod is self-contained — no key file needed on the server. Runtime
# env vars of the same name override the baked-in values if you ever need to.

# REQUIRED — the real Xiaomi MiMo API key. Baked in; injected server-side;
# never sent to clients.
XIAOMI_MIMO_API_KEY=

# Shared token the OpenCrabs client must send (Authorization: Bearer <token>
# or X-OpenCrabs-Token: <token>). Optional but recommended. Baked in if set;
# rotatable. Leave empty to run open (rate-limit + cutoff only).
APP_TOKEN=

# --- The rest are runtime-only (NOT baked); set them in the systemd unit /
# --- environment, or leave them at the defaults below.

# Require a User-Agent containing "opencrabs". 1/true to enable. Soft signal.
REQUIRE_OPENCRABS_UA=false

# Hard end of the free keyless window (UTC, YYYY-MM-DD). After this, returns 410.
CUTOFF_DATE=2026-06-26

# Per-IP requests per minute.
RATE_MAX_PER_MIN=60

# Where to listen. Behind nginx, keep it on localhost.
BIND_ADDR=127.0.0.1:8787

# Upstream Xiaomi base (no trailing slash). Rarely changed.
UPSTREAM_BASE_URL=https://api.xiaomimimo.com

# Log level.
RUST_LOG=info

# Path to the SQLite stats database. Persists across restarts.
# Set to /var/lib/xiaomiproxy/stats.db in production.
STATS_DB=./xiaomiproxy.db
